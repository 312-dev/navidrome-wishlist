# Copy to .env and adjust. Everything the app itself reads is namespaced LW_.

# Where the database, the cookie jars and the cover cache live.
LW_CONFIG_DIR=/config

# Your music library. Purchases are written here.
LW_MUSIC_DIR=/music

LW_HOST=0.0.0.0
LW_PORT=8080

# Required only if you connect a shop that authenticates with a browser
# session, which today means Qobuz. The shared secret a browser extension
# presents to /auth/ingest. Without it that endpoint does not exist at all,
# which is the safe default: it accepts live credentials.
#COOKIE_BROKER_TOKEN=

# An existing cookie jar to adopt, if you already have one. Otherwise a new
# one is kept inside LW_CONFIG_DIR.
#LW_STORE_QOBUZ_JAR_PATH=

# Sources. Each provider reads only its own namespace, and a provider with no
# variable set at all is never built. That is why a missing one is quiet: the
# want list simply stops growing, and the only place it says so is the
# `wired sources=[]` line at startup.
#
# The name has to be USERNAME. Setting USER instead is worse than setting
# nothing, because a single variable under the prefix is enough to build the
# provider, and it then fails on every poll asking for the name it wanted.
#LW_SOURCE_LASTFM_API_KEY=
#LW_SOURCE_LASTFM_USERNAME=
#LW_SOURCE_LISTENBRAINZ_USERNAME=
#LW_SOURCE_LISTENBRAINZ_TOKEN=

# docker-compose.yml only: the host directory bind-mounted at /music.
MUSIC_LIBRARY_DIR=./music
